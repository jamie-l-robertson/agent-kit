{
  "version": 1,
  "hooks": {
    "sessionEnd": [
      {
        "command": "node .agents/hooks/adapters/cursor.mjs"
      }
    ],
    "subagentStart": [
      {
        "command": "node .agents/hooks/adapters/cursor.mjs",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "node .agents/hooks/adapters/cursor.mjs",
        "matcher": "Task",
        "failClosed": true
      }
    ],
    "subagentStop": [
      {
        "command": "node .agents/hooks/adapters/cursor.mjs"
      }
    ],
    "sessionStart": [
      {
        "command": "node .agents/hooks/adapters/cursor.mjs"
      }
    ]
  }
}
